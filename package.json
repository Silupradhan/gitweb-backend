{
  "name": "backend",
  "version": "1.0.0",
  "description": "Node + Express + PostgreSQL (Drizzle ORM) API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "node --check src/server.js && node --check src/app.js",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "npm run test:webhook && npm run test:api && npm run test:sse",
    "test:api": "node scripts/test-api.js",
    "test:sse": "node scripts/test-sse.js",
    "test:webhook": "node scripts/test-webhooks.js",
    "webhook:send": "node scripts/send-sample-event.js"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14"
  }
}
